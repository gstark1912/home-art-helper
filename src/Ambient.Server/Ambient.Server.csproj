<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Development serves dist through the explicit provider in Program.cs.
       Publish copies it without advertising a nonexistent source wwwroot to static web assets. -->
  <Target Name="PublishAmbientClient" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_AmbientClientFile Include="../ambient-client/dist/**/*" />
      <ResolvedFileToPublish Include="@(_AmbientClientFile)">
        <RelativePath>wwwroot/%(_AmbientClientFile.RecursiveDir)%(_AmbientClientFile.Filename)%(_AmbientClientFile.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>

